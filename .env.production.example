# ==============================================================
# Berger WMS — template .env PRODUCTION (VPS)
# ==============================================================
#
# Salin ke server sebagai /opt/berger-wms/.env, isi semua yang bertanda
# <ISI>, lalu periksa:
#
#   docker compose -f docker-compose.prod.yml run --rm php-fpm php artisan wms:cek-produksi
#
# Berkas .env di server berisi rahasia (sandi basis data, App Password Gmail,
# kunci reCAPTCHA). JANGAN di-commit dan jangan dikirim lewat chat.
# Batasi aksesnya: chmod 600 .env
#
# Berkas ini dibaca DUA pihak: Laravel (semua variabel) dan Docker Compose
# (APP_DOMAIN, ACME_EMAIL, DB_*, REDIS_PASSWORD, BACKUP_*).

APP_NAME="Berger WMS"
APP_ENV=production
# Bangkitkan SEKALI: docker compose -f docker-compose.prod.yml run --rm php-fpm php artisan key:generate --show
# Jangan pernah diganti setelah ada data — kolom terenkripsi dan sesi jadi tak terbaca.
APP_KEY=<ISI>
APP_DEBUG=false
APP_URL=https://<ISI-DOMAIN>
APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# --- HTTPS (Caddy) ---
# Domain tanpa https://, mis. wms.bergerpaints.co.id. DNS-nya harus sudah
# mengarah ke IP VPS SEBELUM container dijalankan, supaya sertifikat terbit.
APP_DOMAIN=<ISI-DOMAIN>
# Alamat yang menerima pemberitahuan Let's Encrypt bila sertifikat bermasalah.
ACME_EMAIL=<ISI>

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=wms_berger
DB_USERNAME=wms_user
# Minimal 24 karakter acak: openssl rand -base64 32
DB_PASSWORD=<ISI>

SESSION_DRIVER=redis
SESSION_LIFETIME=60
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

CACHE_STORE=redis
QUEUE_CONNECTION=redis
FILESYSTEM_DISK=local

REDIS_CLIENT=phpredis
REDIS_HOST=redis
# Minimal 24 karakter acak: openssl rand -base64 32
REDIS_PASSWORD=<ISI>
REDIS_PORT=6379

# --- Email ke Sales (lihat docs/8_panduan_email_gmail.md) ---
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=logisticsbpikrw@gmail.com
# 16 huruf App Password Gmail, BUKAN sandi login Gmail.
MAIL_PASSWORD=<ISI>
MAIL_FROM_ADDRESS="logisticsbpikrw@gmail.com"
MAIL_FROM_NAME="Berger WMS - Logistik"
MAIL_REPLY_TO_ADDRESS="logisticsbpikrw@gmail.com"

# --- reCAPTCHA v2 (WAJIB di production) ---
# Daftarkan domain di https://www.google.com/recaptcha/admin (tipe v2
# "Saya bukan robot"). Bila kosong di production, login DITOLAK untuk semua
# orang — sengaja gagal tertutup, bukan diam-diam dilewati.
RECAPTCHA_SITE_KEY=<ISI>
RECAPTCHA_SECRET_KEY=<ISI>

# --- WhatsApp (lihat komentar lengkap di .env.example) ---
WHATSAPP_DRIVER=manual
WHATSAPP_SENDER_NUMBER=087820006254
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TOKEN=
WHATSAPP_TEMPLATE_LANGUAGE=id
WHATSAPP_FONNTE_TOKEN=

WMS_TIMEZONE=Asia/Jakarta
WMS_ORDER_CUTOFF_HOUR=15

# --- Cadangan harian (container `backup`) ---
# Jam WIB paling awal cadangan dibuat, dan berapa hari cadangan disimpan.
BACKUP_JAM=01
BACKUP_HARI=30
