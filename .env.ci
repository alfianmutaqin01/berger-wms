APP_NAME="Berger WMS"
APP_ENV=testing
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=wms_testing
DB_USERNAME=wms_test
DB_PASSWORD=testing

# Nama variabel mengikuti Laravel 11+ (CACHE_STORE / BROADCAST_CONNECTION).
# Nama lama CACHE_DRIVER dan BROADCAST_DRIVER sudah tidak dibaca framework.
CACHE_STORE=array
SESSION_DRIVER=array
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=null
MAIL_MAILER=array

# Timezone & locale disamakan dengan .env agar test yang menyentuh
# cutoff order (15:00 WIB) dan format tanggal tidak meleset di CI.
APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

# Bcrypt dipercepat agar suite test tidak habis waktu di hashing.
BCRYPT_ROUNDS=4

# SENGAJA DIISI (bukan kosong): AuthController::verifyRecaptcha() melewati
# verifikasi sama sekali bila secret key KOSONG di luar production ("mode
# developer tanpa kredensial sendiri") — kalau nilainya kosong di sini, test
# yang mengharapkan reCAPTCHA GAGAL (LoginTest::test_login_gagal_jika_recaptcha_*)
# akan selalu lolos tanpa pernah benar-benar diuji. Nilai di bawah cuma perlu
# ADA (bukan secret asli); Http::fake() di LoginTest yang menentukan hasilnya,
# bukan Google sungguhan.
RECAPTCHA_SITE_KEY=ci-dummy-site-key
RECAPTCHA_SECRET_KEY=ci-dummy-secret-key
