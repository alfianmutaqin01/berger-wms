# ==============================================================
# Berger WMS — superuser PostgreSQL (PRODUCTION)
# ==============================================================
#
# Salin ke server sebagai /opt/berger-wms/.env.postgres, isi, lalu:
#   chmod 600 .env.postgres
#
# Dibaca HANYA oleh container postgres dan backup. Sengaja terpisah dari
# .env: .env di-mount ke container aplikasi, sehingga aplikasi yang tembus
# bisa membaca isinya. Sandi superuser tidak boleh ikut terbawa.
#
# Aplikasi TIDAK memakai akun ini. Aplikasi masuk sebagai DB_USERNAME di .env
# (bukan superuser), dibuat oleh docker/postgres/init.

# Harus BERBEDA dari DB_USERNAME di .env.
POSTGRES_USER=wms_admin
# Minimal 24 karakter acak: openssl rand -base64 32
POSTGRES_PASSWORD=<ISI>
