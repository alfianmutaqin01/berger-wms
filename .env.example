APP_NAME="Berger WMS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_TIMEZONE=Asia/Jakarta

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
# 14 hari terakhir saja. Sebelumnya 'single": satu berkas laravel.log yang
# TIDAK PERNAH dipangkas - sudah 1,5 MB dalam beberapa minggu di mesin
# pengembangan, dan di server produksi berkas seperti itu tumbuh sampai
# mengganggu ruang disk serta membuat pembacaan log jadi lambat.
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database — PostgreSQL
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=wms_berger
DB_USERNAME=wms_user
DB_PASSWORD=secret

# Session — Redis
SESSION_DRIVER=redis
SESSION_LIFETIME=60
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Broadcasting — Soketi (WebSocket)
BROADCAST_CONNECTION=pusher
PUSHER_APP_ID=berger-wms
PUSHER_APP_KEY=app-key
PUSHER_APP_SECRET=app-secret
PUSHER_HOST=soketi
PUSHER_PORT=6001
PUSHER_SCHEME=http

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER=mt1

# Cache — Redis
CACHE_STORE=redis

# Queue — Redis
QUEUE_CONNECTION=redis

# Filesystem
FILESYSTEM_DISK=local

# Redis
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail
MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@bergerpaints.co.id"
MAIL_FROM_NAME="${APP_NAME}"

# Google reCAPTCHA v2 — verifikasi anti-bot pada form login (PRD v1.2 F-AUTH-02).
# Kosongkan di lingkungan lokal/test untuk melewati verifikasi.
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# WhatsApp — tautan konfirmasi untuk supir (F-OUT-04 #10).
#
# manual : BAWAAN. Sistem menyiapkan pesan + tautan; Logistik menekan tombol
#          "Buka WhatsApp" lalu mengirimnya sendiri. Tanpa langganan, tanpa
#          risiko nomor perusahaan diblokir. Bisa dipakai hari ini.
# cloud  : WhatsApp Cloud API resmi Meta. Otomatis penuh. Isi ketiga nilai di
#          bawah; kalau salah satunya kosong, sistem TURUN ke mode manual
#          alih-alih meledak.
# log    : mencatat ke log, untuk pengembangan.
#
# Sebelum 'cloud' bisa dipakai, di sisi Meta harus ada:
#   1. Akun Meta Business yang sudah terverifikasi
#   2. Nomor telepon KHUSUS yang belum pernah dipakai WhatsApp biasa
#   3. Template kategori "utility" yang sudah disetujui — pesan yang dimulai
#      bisnis ke nomor yang belum pernah membalas WAJIB berupa template, dan
#      supir tidak akan pernah membalas lebih dulu.
WHATSAPP_DRIVER=manual
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TOKEN=
WHATSAPP_TEMPLATE=konfirmasi_pengiriman
WHATSAPP_TEMPLATE_LANGUAGE=id

VITE_APP_NAME="${APP_NAME}"
