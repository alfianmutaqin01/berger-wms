APP_NAME="Berger WMS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_TIMEZONE=Asia/Jakarta

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
# 14 hari terakhir saja. Sebelumnya 'single": satu berkas laravel.log yang
# TIDAK PERNAH dipangkas - sudah 1,5 MB dalam beberapa minggu di mesin
# pengembangan, dan di server produksi berkas seperti itu tumbuh sampai
# mengganggu ruang disk serta membuat pembacaan log jadi lambat.
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database — PostgreSQL
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=wms_berger
DB_USERNAME=wms_user
DB_PASSWORD=secret

# Session — Redis
SESSION_DRIVER=redis
SESSION_LIFETIME=60
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Broadcasting — Soketi (WebSocket)
BROADCAST_CONNECTION=pusher
PUSHER_APP_ID=berger-wms
PUSHER_APP_KEY=app-key
PUSHER_APP_SECRET=app-secret
PUSHER_HOST=soketi
PUSHER_PORT=6001
PUSHER_SCHEME=http

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER=mt1

# Cache — Redis
CACHE_STORE=redis

# Queue — Redis
QUEUE_CONNECTION=redis

# Filesystem
FILESYSTEM_DISK=local

# Redis
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail
MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@bergerpaints.co.id"
MAIL_FROM_NAME="${APP_NAME}"

# Google reCAPTCHA v2 — verifikasi anti-bot pada form login (PRD v1.2 F-AUTH-02).
# Kosongkan di lingkungan lokal/test untuk melewati verifikasi.
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# WhatsApp — tiga jenis pesan keluar dari sistem:
#   1. tautan konfirmasi sampai untuk SUPIR       (F-OUT-04 #10)
#   2. tautan persetujuan MRF untuk ATASAN         (MRF)
#   3. kabar barang sampai untuk SALES pemesan     (dipicu konfirmasi supir)
#
# manual : BAWAAN. Sistem menyiapkan pesan + tautan; orangnya menekan tombol
#          "Buka WhatsApp" lalu mengirimnya sendiri. Tanpa langganan, tanpa
#          risiko nomor perusahaan diblokir.
#          PERHATIAN: pesan no. 3 TIDAK PERNAH KELUAR di mode ini — yang
#          memicunya supir di halaman publik, jadi tidak ada orang di sisi
#          perusahaan yang menekan kirim. Sales tetap menerima lonceng web.
# cloud  : WhatsApp Cloud API resmi Meta. Otomatis penuh. Kalau
#          WHATSAPP_PHONE_NUMBER_ID atau WHATSAPP_TOKEN kosong, sistem TURUN
#          ke mode manual alih-alih meledak.
# fonnte : Gateway Fonnte lewat nomor WhatsApp biasa yang ditautkan (pindai
#          QR seperti WhatsApp Web). Otomatis dan bisa dipakai hari ini, TETAPI
#          melanggar ketentuan WhatsApp — nomornya bisa diblokir. Kalau
#          WHATSAPP_FONNTE_TOKEN kosong, sistem TURUN ke mode manual.
# log    : mencatat ke log, untuk pengembangan.
WHATSAPP_DRIVER=manual

# Nomor yang seharusnya tampil sebagai pengirim. CATATAN, bukan pengatur:
# Meta menentukan pengirim dari PHONE_NUMBER_ID, Fonnte dari tokennya.
WHATSAPP_SENDER_NUMBER=087820006254

# --- Meta Cloud API ---------------------------------------------------------
# Syarat di sisi Meta:
#   1. Akun Meta Business yang sudah terverifikasi
#   2. Nomor KHUSUS yang tidak dipakai di aplikasi WhatsApp biasa — nomor yang
#      sedang aktif di HP harus dilepas dulu dan tidak bisa kembali dipakai
#      di aplikasi selama tersambung ke Cloud API
#   3. SATU template kategori "utility" per jenis pesan, disetujui Meta.
#      Isi yang diajukan (URUTAN {{n}} WAJIB PERSIS seperti ini):
#
#   konfirmasi_pengiriman
#     Pengiriman Berger Paints sedang menuju tujuan. Setelah barang sampai,
#     mohon buka tautan ini lalu tekan tombol konfirmasi: {{1}}
#
#   persetujuan_mrf
#     Halo {{1}}, permintaan material {{2}} dari {{3}} menunggu persetujuan
#     Anda. Buka tautan ini untuk menyetujui atau menolak: {{4}}
#
#   barang_sampai_sales
#     Halo {{1}}, pesanan {{2}} untuk {{3}} sudah SAMPAI di tujuan (Surat
#     Jalan {{4}}). Unggah foto Surat Jalan bertanda tangan agar pesanan bisa
#     ditutup: {{5}}
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TOKEN=
WHATSAPP_TEMPLATE_LANGUAGE=id
# Isi hanya bila nama yang disetujui Meta berbeda dari nama di atas.
WHATSAPP_TEMPLATE=konfirmasi_pengiriman
WHATSAPP_TEMPLATE_MRF=persetujuan_mrf
WHATSAPP_TEMPLATE_BARANG_SAMPAI=barang_sampai_sales

# --- Fonnte -----------------------------------------------------------------
# Token PERANGKAT dari dashboard fonnte.com, milik nomor pengirim di atas.
WHATSAPP_FONNTE_TOKEN=

VITE_APP_NAME="${APP_NAME}"
